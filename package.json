{
  "name": "alsatools",
  "version": "0.1.0",
  "description": "Safe ALSA alsaequal virtual PCM manager",
  "type": "module",
  "bin": {
    "alsatools": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "start": "node dist/index.js",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "execa": "^9.6.0",
    "ink": "^6.3.1",
    "react": "^19.1.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.16",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.8"
  }
}
